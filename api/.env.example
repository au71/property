# --- Core ---
NODE_ENV=development
PORT=4000
# SQLite file. Relative paths resolve from the api/ directory.
DATABASE_URL="file:./prisma/dev.db"

# --- Auth ---
# 32+ random bytes. Generate with: openssl rand -base64 48
JWT_SECRET="dev-only-insecure-secret-change-me-in-every-real-environment"
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# --- CORS ---
# Comma-separated list of allowed browser origins.
WEB_ORIGIN="http://localhost:3000"

# --- Media storage ---
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=var/uploads
# Public base URL that media paths are prefixed with.
PUBLIC_BASE_URL="http://localhost:4000"

# --- SMS (OTP) ---
# noop writes the code to the log instead of sending it.
SMS_PROVIDER=noop

# --- Jobs ---
ENABLE_CRON=true
