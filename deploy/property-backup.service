[Unit]
Description=Back up the property portal database and uploads
After=property-api.service

[Service]
Type=oneshot
User=property
Group=property
ExecStart=/srv/property/deploy/backup.sh
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/property/data /srv/property/backups

StandardOutput=journal
StandardError=journal
SyslogIdentifier=property-backup
