# API origin the device will call.
#
# "localhost" only works in a web build or an iOS simulator. On a physical
# device or an Android emulator it points at the device itself, so use the
# machine's LAN address (e.g. http://192.168.1.20:4000) or 10.0.2.2 for the
# Android emulator.
EXPO_PUBLIC_API_URL=http://localhost:4000
